# ============================================================
# DJDI Golf Board — environment configuration
# Copy to .env (dotenv is loaded by server.ts). Every variable is
# optional; the app runs with sensible defaults for local dev.
# ============================================================

# --- Core app ---
# SQLite database file (defaults to ./golf_coordinator.db)
#DB_PATH=./golf_coordinator.db
# Port for the Express server (defaults to 3000)
#PORT=3000
# Group access gate: setting this requires members to enter the code once
#ACCESS_CODE=

# --- Text the Board (message-to-app agent) ---
# Shared secret the relay must send as X-Relay-Secret. The inbound
# webhook stays disabled until this is set.
#RELAY_SECRET=

# Parse-model provider policy (see agent/providers.ts):
#   1. AGENT_PROVIDER=ollama|anthropic forces a provider.
#   2. Otherwise OLLAMA_URL (if set) wins — free beats metered.
#   3. Otherwise ANTHROPIC_API_KEY is used if present.
#   4. Otherwise the agent reports itself offline.
#OLLAMA_URL=http://127.0.0.1:11434

# Model override for whichever provider wins. Ollama default is
# qwen2.5:7b (live-verified). Hermes tags work too — the adapter recovers
# tool calls their templates render as text — but verify parse accuracy
# with scripts/agent-chat.ts before switching the league. Pull first
# (e.g. `ollama pull hermes3`) and set:
#AGENT_MODEL=hermes3

# Metered Anthropic API — strictly opt-in (defaults to claude-haiku-4-5
# when chosen; override with AGENT_MODEL).
#ANTHROPIC_API_KEY=
#AGENT_PROVIDER=
