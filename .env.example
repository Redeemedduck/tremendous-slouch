# Copy this file to .env.local for local runtime configuration.
# .env.local is ignored by git.

HOST=127.0.0.1
PORT=3000
DB_PATH=./golf_coordinator.db

# Set before sharing the board beyond your own machine.
ACCESS_CODE=

# Set a different code for money, roster, launch checks, and backups.
COMMISSIONER_CODE=

# Set to 1 only after each launch gate is actually verified.
DJDI_DOCKER_BUILD_VERIFIED=
DJDI_TAILNET_URL_VERIFIED=
DJDI_PRODUCTION_URL_VERIFIED=
DJDI_MOBILE_SAFARI_VERIFIED=

# Keep unset/0 for the private Tailscale setup. Set to 1 only if you choose
# to require an optional public/always-on URL in addition to the tailnet URL.
DJDI_REQUIRE_PRODUCTION_URL=

# Optional phone-access diagnostics shown by /api/network-status.
APP_BASE_PATH=/golf
VITE_BASE_PATH=/golf/
DJDI_MAGICDNS_URL=https://duckbookpro.clouded-tailor.ts.net/golf
DJDI_TAILNET_URL=https://duckbookpro.clouded-tailor.ts.net/golf
DJDI_TAILNET_API_URL=https://duckbookpro.clouded-tailor.ts.net/golf-api
DJDI_DIRECT_TAILSCALE_URL=http://100.102.92.28:3131/golf
DJDI_DIRECT_TAILSCALE_API_URL=http://100.102.92.28:3131/golf-api
DJDI_PHONE_ROOT_URL=http://100.102.92.28:3131/golf
DJDI_LAN_URL=http://192.168.8.210:3131
